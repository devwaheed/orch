exports[`orch CLI > orch accounts add <agent> "<name>" verifies account and prints status 1`] = `
[
  "Signing in to Codex · Client. Codex’s own sign-in runs below; your password never passes through orch. Press Ctrl-] when you’ve signed in and it doesn’t close by itself.",
  "✓ Signed in as n•••@client.com
✓ Kept separate: in its own private folder.
✓ Ready: usage tracking is on and orch can route work to it.",
]
`;

exports[`orch CLI > orch accounts lists accounts in formatted table 1`] = `
[
  "ACCOUNT          EMAIL           STATUS      PRIMARY  USE
claude@personal  a•••@gmail.com  available   yes      yes
claude@work      a•••@acme.dev   near·limit  no       yes
