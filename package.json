{
  "name": "orch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && stylelint \"**/*.css\" --allow-empty-input --ignore-pattern \"**/dist/**\" && depcruise packages --config tools/depcruise.cjs",
    "test": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests && pnpm --filter @orchagents/app test:e2e",
    "dev": "node -e \"console.log('not implemented yet'); process.exit(0)\"",
    "dev:headless": "node --import ./packages/app/test/support/source-ts-loader.mjs ./packages/app/src/node/coreHost.ts",
    "help:shots": "pnpm --filter @orchagents/app dist:dir && node docs-site/scripts/shots.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.27.11",
    "@playwright/test": "1.49.1",
    "@types/node": "22.20.5",
    "dependency-cruiser": "16.9.0",
    "eslint": "9.18.0",
    "stylelint": "16.12.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "vitest": "2.1.9",
    "yaml": "2.6.1",
    "zod": "3.25.76"
  },
  "pnpm": {
    "patchedDependencies": {
      "@enderfga/claw-orchestrator@7.5.6": "patches/@enderfga__claw-orchestrator@7.5.6.patch"
    }
  }
}
